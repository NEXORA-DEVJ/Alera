# ========================================================
# ALERA - Local Environment Configuration
# ========================================================

# PostgreSQL + PostGIS
POSTGRES_DB=alera_db
POSTGRES_USER=alera_user
POSTGRES_PASSWORD=alera_dev_password
POSTGRES_PORT=5432

# Redis (Mapeado a 6380 para evitar colisiones locales)
REDIS_PORT=6380
REDIS_PASSWORD=alera_redis_password

# MinIO (Almacenamiento S3 local para multimedia)
MINIO_ROOT_USER=alera_minio_admin
MINIO_ROOT_PASSWORD=alera_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
